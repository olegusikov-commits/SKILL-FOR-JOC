diff --git a/src/chequeflow/rules.py b/src/chequeflow/rules.py
index 95f9cfd..6349746 100644
--- a/src/chequeflow/rules.py
+++ b/src/chequeflow/rules.py
@@ -9,7 +9,22 @@ AUTO_APPROVED = "AUTO_APPROVED"
 TO_CLERK = "TO_CLERK"
 
 
+def _is_recurring_institutional(cheque: Cheque, payer: Payer) -> bool:
+    # CHQ-512: משכורות וקצבאות ממושכים קבועים כמעט אף פעם לא נדחים
+    return (
+        payer.payer_type in config.RECURRING_PAYER_TYPES
+        and cheque.payer_prev_cheques > config.RECURRING_PAYER_MIN_HISTORY
+        and cheque.ocr_amount <= config.RECURRING_PAYER_MAX_AMOUNT
+        and cheque.ocr_amount_conf >= config.OCR_AMOUNT_MIN_CONF
+        and cheque.ocr_date_conf >= config.OCR_DATE_MIN_CONF
+        and cheque.ocr_signature_score >= config.SIGNATURE_MIN_SCORE
+    )
+
+
 def decide(cheque: Cheque, account: Account, payer: Payer) -> Decision:
+    if _is_recurring_institutional(cheque, payer):
+        return Decision(AUTO_APPROVED, "AUTO_RECURRING_PAYER")
+
     # עצירות קשיחות: אסור לאשר אוטומטית בשום מקרה
     if account.status != "ACTIVE":
         return Decision(TO_CLERK, "ACCOUNT_BLOCKED")
