+
+    def find_cheque_ids_by_branch(self, branch_id, since):
+        try:
+            conn = self._connect()
+            rows = conn.execute(
+                f"SELECT cheque_id FROM cheques WHERE branch_id = '{branch_id}' "
+                f"AND received_at >= '{since}'"
+            ).fetchall()
+            return [r[0] for r in rows]
+        except Exception:
+            return []
