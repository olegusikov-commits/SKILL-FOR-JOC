@@ -9,6 +9,20 @@ AUTO_APPROVED = "AUTO_APPROVED"
 TO_CLERK = "TO_CLERK"
 
 
+def is_recurring_payer(cheque: Cheque, payer: Payer) -> bool:
+    """מושך קבוע לפי SPEC-001 (הפרדיקט היחיד, משמש גם את עצירת הסכום וגם את האישור).
+
+    הספים נקראים מ-config בזמן הקריאה כדי שבדיקות יוכלו לשנות אותם.
+    תנאי "הסכום מעל 1000" נבדק אצל הקורא, לא כאן.
+    """
+    return (
+        config.RECURRING_PAYER_ENABLED
+        and payer.payer_type in config.RECURRING_PAYER_TYPES
+        and cheque.payer_prev_cheques >= config.RECURRING_PAYER_MIN_PREV_CHEQUES
+        and cheque.ocr_amount <= config.RECURRING_PAYER_MAX_AMOUNT
+    )
+
+
 def decide(cheque: Cheque, account: Account, payer: Payer) -> Decision:
     # עצירות קשיחות: אסור לאשר אוטומטית בשום מקרה
     if account.status != "ACTIVE":
@@ -18,7 +32,9 @@ def decide(cheque: Cheque, account: Account, payer: Payer) -> Decision:
 
     if cheque.channel not in config.AUTO_APPROVE_CHANNELS:
         return Decision(TO_CLERK, "CHANNEL_NOT_ALLOWED")
-    if cheque.ocr_amount > config.AUTO_APPROVE_MAX_AMOUNT:
